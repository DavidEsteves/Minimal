<Window x:Class="Minimal.Views.SaveChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved changes" Width="474" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Chrome}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#67B1E8"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="8" Margin="12">
    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBar}" CornerRadius="7,7,0,0">
      <Grid Height="36" Background="Transparent" MouseLeftButtonDown="DragTitleBar">
        <TextBlock Text="Unsaved changes" Foreground="{DynamicResource CaptionInk}" VerticalAlignment="Center" Margin="16,0,48,0" FontSize="12" IsHitTestVisible="False"/>
        <Button Content="×" HorizontalAlignment="Right" Width="40" MinWidth="0" Margin="0" Padding="0" Background="Transparent" BorderBrush="Transparent" FontSize="18" Click="CancelClick" ToolTip="Cancel" AutomationProperties.Name="Close dialog" Focusable="False"/>
      </Grid>
      </Border>
      <StackPanel Margin="24,20,24,24">
        <TextBlock x:Name="DocumentName" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
        <TextBlock Text="Your changes will be lost if you don’t save them." Foreground="{DynamicResource CaptionInk}" TextWrapping="Wrap" Margin="0,12,0,26"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="SaveButton" Content="_Save" IsDefault="True" Background="#0F6CBD" Foreground="White" BorderBrush="#0F6CBD" Click="SaveClick"/>
          <Button Content="_Don't save" Click="DiscardClick"/>
          <Button Content="_Cancel" IsCancel="True"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
