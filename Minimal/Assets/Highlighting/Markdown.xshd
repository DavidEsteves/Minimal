<SyntaxDefinition name="Markdown" extensions=".md;.markdown;.mdown" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Heading" foreground="#245AAB" fontWeight="bold"/>
  <Color name="Code" foreground="#8C4020"/>
  <Color name="Link" foreground="#176880"/>
  <Color name="Emphasis" foreground="#7A378B"/>
  <RuleSet>
    <Span color="Code" multiline="true"><Begin>^\s*```.*$</Begin><End>^\s*```\s*$</End></Span>
    <Span color="Code" multiline="true"><Begin>^\s*~~~.*$</Begin><End>^\s*~~~\s*$</End></Span>
    <Rule color="Heading">^\s{0,3}\#{1,6}\s.*$</Rule>
    <Rule color="Heading">^\s*(===+|---+)\s*$</Rule>
    <Span color="Code" begin="`" end="`"/>
    <Rule color="Link">!?\[[^\]]*\]\([^)]*\)</Rule>
    <Rule color="Emphasis">\*\*[^*]+\*\*|__[^_]+__|\*[^*]+\*|_[^_]+_|~~[^~]+~~</Rule>
    <Rule color="Link">^\s*(&gt;|[-+*]|\d+\.)\s</Rule>
  </RuleSet>
</SyntaxDefinition>
