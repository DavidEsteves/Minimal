<SyntaxDefinition name="YAML" extensions=".yaml;.yml" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#587949"/>
  <Color name="Key" foreground="#234EAD"/>
  <Color name="String" foreground="#A14427"/>
  <Color name="Value" foreground="#77549B"/>
  <RuleSet>
    <Span color="Comment" begin="\#"/>
    <Span color="String" begin="&quot;" end="&quot;"><RuleSet><Span begin="\\" end="."/></RuleSet></Span>
    <Span color="String" begin="'" end="'"/>
    <Rule color="Key">[\w.-]+(?=\s*:)</Rule>
    <Keywords color="Value"><Word>true</Word><Word>false</Word><Word>null</Word><Word>yes</Word><Word>no</Word></Keywords>
    <Rule color="Value">\b\d+(\.\d+)?\b|[&amp;*][\w-]+|^---$</Rule>
  </RuleSet>
</SyntaxDefinition>
