<SyntaxDefinition name="PowerShell" extensions=".ps1;.psm1;.psd1" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#587949"/>
  <Color name="String" foreground="#A14427"/>
  <Color name="Keyword" foreground="#234EAD" fontWeight="bold"/>
  <Color name="Variable" foreground="#77549B"/>
  <RuleSet ignoreCase="true">
    <Span color="Comment" multiline="true" begin="&lt;\#" end="\#&gt;"/>
    <Span color="Comment" begin="\#"/>
    <Span color="String" begin="&quot;" end="&quot;"><RuleSet><Span begin="`" end="."/></RuleSet></Span>
    <Span color="String" begin="'" end="'"/>
    <Rule color="Variable">\$[\w:?]+|\$\{[^}]+\}</Rule>
    <Keywords color="Keyword"><Word>function</Word><Word>param</Word><Word>if</Word><Word>else</Word><Word>elseif</Word><Word>foreach</Word><Word>for</Word><Word>while</Word><Word>do</Word><Word>switch</Word><Word>return</Word><Word>break</Word><Word>continue</Word><Word>try</Word><Word>catch</Word><Word>finally</Word><Word>throw</Word><Word>class</Word><Word>enum</Word><Word>begin</Word><Word>process</Word><Word>end</Word><Word>in</Word></Keywords>
    <Rule color="Keyword">\b[A-Za-z]+-[A-Za-z]+\b</Rule>
  </RuleSet>
</SyntaxDefinition>
